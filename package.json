{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview": "vite preview",
    "prestart": "npm run build",
    "start": "node dist/server.cjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit && npm run lint:eslint",
    "lint:eslint": "eslint \"src/**/*.{ts,tsx}\" \"server/**/*.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/build-test-db.cjs && vitest run",
    "test:route-table": "vitest run server/routes/__tests__/route-table.test.ts",
    "db:test-build": "node scripts/build-test-db.cjs",
    "db:restore": "node scripts/restore-db.mjs",
    "check:write-drift": "node scripts/find-write-column-drift.cjs",
    "check:sql-interpolation": "node scripts/find-sql-interpolation.cjs",
    "check:drift": "node scripts/verify-drift.cjs",
    "check:env": "node scripts/check-env-format.cjs",
    "check:pg-prepare": "tsx scripts/check-pg-prepare.ts",
    "verify": "npm run lint && npm run test && npm run check:drift && npm run check:env && npm run build",
    "check:tables": "tsx scripts/check-table-coverage.ts",
    "db:test-schema": "tsx scripts/build-test-schema.ts",
    "gen:test-data": "tsx scripts/generate-test-data.ts --reset",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:db": "npm run db:test-schema && npm run gen:test-data && npm run test:integration",
    "ui:smoke": "node scripts/ui-smoke.mjs",
    "mobile:add": "cap add android && cap add ios",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android:debug": "npm run mobile:sync && cd android && gradlew.bat assembleDebug",
    "mobile:android:release": "npm run mobile:sync && cap build android",
    "mobile:ios": "npm run mobile:sync && cap build ios"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@google/genai": "^1.29.0",
    "@simplewebauthn/server": "^14.0.2",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.102.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "framer-motion": "^12.38.0",
    "helmet": "^8.3.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.4"
  },
  "overrides": {
    "qs": "^6.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/ui": "^5.1.2",
    "autoprefixer": "^10.4.21",
    "better-sqlite3": "^13.1.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.2.3",
    "vitest": "^5.1.2"
  }
}

# NODE_ENV: "development" for local work, "production" for deployed servers.
# In production the server refuses to start without a strong JWT_SECRET (fail fast).
NODE_ENV=development

# PostgreSQL connection used by the hosted multi-device server.
# Provision a dedicated database or an isolated schema for this application.
DATABASE_URL=postgresql://payroll_app:replace-this-password@localhost:5432/payroll
PGSCHEMA=payroll
PG_POOL_MAX=12
PG_CONNECT_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000

# Docker Compose PostgreSQL service. Set DATABASE_URL's host to "db" when using Compose.
POSTGRES_DB=payroll
POSTGRES_USER=payroll_app
POSTGRES_PASSWORD=replace-this-password
APP_PORT=3000
CORS_ORIGINS=https://payroll.example.com

# JWT_SECRET: Signing key for session tokens. MUST be a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY
# GEMINI_MODEL: comma-separated model fallbacks, tried in order.
GEMINI_MODEL=gemini-flash-lite-latest,gemini-flash-latest,gemini-3.8-flash

# Anonymous self-hosted frontend error collector. No vendor and no API key.
# Build-time client settings (embedded in the browser bundle, not secrets).
VITE_CLIENT_ERRORS_ENABLED=true
VITE_CLIENT_ERROR_ENDPOINT=/api/client-errors
# Native APK builds only: an absolute HTTPS endpoint instead of the relative path.
# VITE_ERROR_REPORT_URL=https://hr.restocost.shop/api/client-errors
# Server-side kill switch; console logging stays on either way.
CLIENT_ERROR_REPORTING_ENABLED=true

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=MY_APP_URL
